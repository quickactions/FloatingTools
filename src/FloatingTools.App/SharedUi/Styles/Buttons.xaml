<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FloatingToolsSharedButtonBaseStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushTransparent}" />
        <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsSpacingNone}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="FloatingToolsSharedChromeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceControl}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceSubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsSharedToolTileButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceControl}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FloatingToolsRadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceSubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsSharedIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
        <Setter Property="Width" Value="{StaticResource FloatingToolsSizeIconButton}" />
        <Setter Property="Height" Value="{StaticResource FloatingToolsSizeIconButton}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingNone}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FloatingToolsRadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource FloatingToolsOpacityDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsSharedActionButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
        <Setter Property="MinHeight" Value="{StaticResource FloatingToolsSizeActionButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingActionButton}" />
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FloatingToolsRadiusControl}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource FloatingToolsOpacityDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
