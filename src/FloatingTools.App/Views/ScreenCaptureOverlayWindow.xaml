<Window x:Class="FloatingTools.App.Views.ScreenCaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select text area"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#33000000"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseLeftButtonDown="OnMouseLeftButtonDown"
        PreviewMouseMove="OnMouseMove"
        PreviewMouseLeftButtonUp="OnMouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas">
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                Background="#08FFFFFF"
                BorderBrush="#FFF1F1F2"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <Border Canvas.Left="14"
                Canvas.Top="14"
                Padding="9,5"
                Background="#DD252528"
                CornerRadius="5"
                IsHitTestVisible="False">
            <TextBlock Text="Drag around English text · Esc to cancel"
                       Foreground="#FFF1F1F2"
                       FontFamily="Segoe UI"
                       FontSize="12" />
        </Border>
    </Canvas>
</Window>
