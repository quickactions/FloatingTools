    <Color x:Key="FloatingToolsColorScrollThumb">#FF55555A</Color>
    <Color x:Key="FloatingToolsColorScrollThumbHover">#FF737379</Color>
    <Color x:Key="FloatingToolsColorScrollThumbPressed">#FF85858B</Color>
    <Color x:Key="FloatingToolsColorSurfaceMessageUser">#FF343A47</Color>
    <Color x:Key="FloatingToolsColorAccentToday">#FF324F69</Color>
    <Color x:Key="FloatingToolsColorAccentHoliday">#FF8FC9F2</Color>
    <Color x:Key="FloatingToolsColorAccentFavorite">#FFE2C96F</Color>
    <Color x:Key="FloatingToolsColorStatusWarning">#FFC0A36A</Color>
