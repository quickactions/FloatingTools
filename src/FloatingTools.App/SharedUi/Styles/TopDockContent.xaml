<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Opt-in reading widths for Top Dock. No implicit style affects tool layout. -->
    <Thickness x:Key="TopDockReadingHorizontalMargin">16,0,16,0</Thickness>
    <sys:Double x:Key="TopDockDefaultReadingMaxWidth">400</sys:Double>
    <sys:Double x:Key="TopDockCompactReadingMaxWidth">340</sys:Double>

    <Style x:Key="TopDockDefaultReadingWidthStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="{StaticResource TopDockReadingHorizontalMargin}" />
        <Setter Property="MaxWidth" Value="{StaticResource TopDockDefaultReadingMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TopDockCompactReadingWidthStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource TopDockDefaultReadingWidthStyle}">
        <Setter Property="MaxWidth" Value="{StaticResource TopDockCompactReadingMaxWidth}" />
    </Style>
</ResourceDictionary>
