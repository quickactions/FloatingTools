<UserControl x:Class="FloatingTools.App.Views.NotesToolView"
             x:Name="NotesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FloatingTools.App.Models"
              xmlns:views="clr-namespace:FloatingTools.App.Views"
              xmlns:converters="clr-namespace:FloatingTools.App.Converters"
              xmlns:controls="clr-namespace:FloatingTools.App.Controls"
              xmlns:sharedControls="clr-namespace:FloatingTools.App.SharedUi.Controls"
              xmlns:popups="clr-namespace:FloatingTools.App.SharedUi.Popups"
             Focusable="True"
             PreviewKeyDown="NotesToolView_OnPreviewKeyDown"
             AllowDrop="True"
             PreviewDragOver="NotesToolView_OnPreviewDragOver"
             PreviewDrop="NotesToolView_OnPreviewDrop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NoteTitleDirectionConverter x:Key="NoteTitleDirectionConverter" />
        <converters:LocalImagePathConverter x:Key="LocalImagePathConverter" />
        <converters:ResponsiveImageDimensionConverter x:Key="ResponsiveImageDimensionConverter" />

        <Style TargetType="{x:Type ToolTip}"
               BasedOn="{StaticResource FloatingToolsSharedToolTipStyle}" />

        <Style x:Key="NotesImageResizeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ResizeHandle"
                                Background="{DynamicResource FloatingToolsBrushScrollThumb}"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResizeHandle"
                                        Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushScrollThumbHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesTextActionStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingActionButton}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource FloatingToolsRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NotesToolHeaderChevronTemplate">
            <TextBlock Text="⌄" />
        </DataTemplate>

        <Style x:Key="NotesToolHeaderStyle"
               TargetType="{x:Type sharedControls:ToolHeaderControl}"
               BasedOn="{StaticResource FloatingToolsSharedToolHeaderStyle}">
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingActionButton}" />
            <Setter Property="TitleHorizontalAlignment" Value="Stretch" />
            <Setter Property="TitleMargin" Value="0,0,20,0" />
            <Setter Property="ChevronTemplate" Value="{StaticResource NotesToolHeaderChevronTemplate}" />
            <Setter Property="ChevronBrush" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesMenuItemStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource NotesTextActionStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
        </Style>

        <Style x:Key="NotesInputTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource FloatingToolsSharedTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource FloatingToolsBrushTransparent}"
                                BorderThickness="{StaticResource FloatingToolsSpacingNone}"
                                CornerRadius="{StaticResource FloatingToolsRadiusControl}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputSurface"
                                        Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSurfaceFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alias only. NotesInputTextBoxStyle stays as it is because the
             rename box still uses it; the search moves to the shared search
             family without disturbing that. -->
        <Style x:Key="NotesSearchTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource FloatingToolsSearchTextBoxStyle}" />

        <Style x:Key="NotesContextMenuStyle"
               TargetType="{x:Type ContextMenu}"
               BasedOn="{StaticResource FloatingToolsSharedContextMenuStyle}">
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderDefault}" />
        </Style>
        <Style x:Key="NotesMenuSurfaceStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderDefault}" />
            <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsStrokeThin}" />
            <Setter Property="CornerRadius" Value="{StaticResource FloatingToolsRadiusMenu}" />
            <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingMenuSurface}" />
        </Style>
        <Style x:Key="NotesActionMenuItemStyle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource FloatingToolsSharedMenuItemStyle}">
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="ActionSurface"
                                    Background="{DynamicResource FloatingToolsBrushTransparent}"
                                    CornerRadius="{StaticResource FloatingToolsRadiusControl}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="1"
                                               Margin="16,0,0,0"
                                               Text="›"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   HorizontalOffset="2"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource FloatingToolsBrushSurfaceElevated}"
                                        BorderBrush="{DynamicResource FloatingToolsBrushBorderDefault}"
                                        BorderThickness="{StaticResource FloatingToolsStrokeThin}"
                                        CornerRadius="{StaticResource FloatingToolsRadiusMenu}"
                                        Padding="{StaticResource FloatingToolsSpacingMenuSurface}">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ActionSurface"
                                        Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="NotesInsertionContextMenu"
                     x:Shared="False"
                     Style="{StaticResource NotesContextMenuStyle}">
            <MenuItem Header="Add text block"
                      Style="{StaticResource NotesActionMenuItemStyle}"
                      Click="InsertionAddTextMenuItem_OnClick" />
            <MenuItem Header="Add link block"
                      Style="{StaticResource NotesActionMenuItemStyle}"
                      Click="InsertionAddLinkListMenuItem_OnClick" />
        </ContextMenu>

        <Style x:Key="NotesIntermediateInsertionZoneStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="ContextMenu"
                    Value="{StaticResource NotesInsertionContextMenu}" />
            <EventSetter Event="MouseLeftButtonDown"
                         Handler="InsertionZone_OnMouseLeftButtonDown" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="Transparent" Offset="0.44" />
                                <GradientStop Color="{DynamicResource FloatingToolsColorSurfaceInsertionHighlight}" Offset="0.44" />
                                <GradientStop Color="{DynamicResource FloatingToolsColorSurfaceInsertionHighlight}" Offset="0.56" />
                                <GradientStop Color="Transparent" Offset="0.56" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesTrailingInsertionZoneStyle" TargetType="{x:Type Border}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="ContextMenu"
                    Value="{StaticResource NotesInsertionContextMenu}" />
        </Style>

        <DataTemplate DataType="{x:Type models:TextNoteBlock}">
            <StackPanel>
                <Border x:Name="InsertionZone"
                        Style="{StaticResource NotesIntermediateInsertionZoneStyle}"
                        Tag="{Binding}" />
                <controls:NoteDirectionalTextBox
                    x:Name="TextBlockEditor"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                    Tag="{Binding Id}"
                    Margin="0"
                    Padding="16,5"
                    MinHeight="31"
                    Background="White"
                    Foreground="#FF202124"
                    CaretBrush="#FF202124"
                    SelectionBrush="#FFB8BCC4"
                    SelectionOpacity="0.65"
                    IsInactiveSelectionHighlightEnabled="True"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Top"
                    FontFamily="Segoe UI"
                    FontSize="15"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    FocusVisualStyle="{x:Null}"
                    SpellCheck.IsEnabled="False"
                    GotKeyboardFocus="TextBlockEditor_OnGotKeyboardFocus"
                    LostKeyboardFocus="TextBlockEditor_OnLostKeyboardFocus"
                    PreviewMouseLeftButtonDown="TextBlockEditor_OnPreviewMouseLeftButtonDown">
                    <controls:NoteDirectionalTextBox.ContextMenu>
                        <ContextMenu Style="{StaticResource NotesContextMenuStyle}">
                            <MenuItem Header="Copy block"
                                      Tag="BlockAction"
                                      Style="{StaticResource NotesActionMenuItemStyle}"
                                      Click="TextBlockCopyMenuItem_OnClick" />
                            <MenuItem Header="Cut block"
                                      Tag="BlockAction"
                                      Style="{StaticResource NotesActionMenuItemStyle}"
                                      Click="TextBlockCutMenuItem_OnClick" />
                            <MenuItem Header="Delete block"
                                      Tag="BlockAction"
                                      Style="{StaticResource NotesActionMenuItemStyle}"
                                      Click="TextBlockDeleteMenuItem_OnClick" />
                        </ContextMenu>
                    </controls:NoteDirectionalTextBox.ContextMenu>
                </controls:NoteDirectionalTextBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LinkListNoteBlock}">
            <StackPanel>
                <Border x:Name="InsertionZone"
                        Style="{StaticResource NotesIntermediateInsertionZoneStyle}"
                        Tag="{Binding}" />
                <controls:LinkListBlockControl
                    Owner="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type views:NotesToolView}}}"
                    ClampBoundsElement="{Binding NotesContentSurfaceElement, RelativeSource={RelativeSource AncestorType={x:Type views:NotesToolView}}}"
                    PopupHost="{Binding NotesPopupHostElement, RelativeSource={RelativeSource AncestorType={x:Type views:NotesToolView}}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ImageNoteBlock}">
            <StackPanel>
                <Border x:Name="InsertionZone"
                        Style="{StaticResource NotesIntermediateInsertionZoneStyle}"
                        Tag="{Binding}" />
            <Grid Background="Transparent"
                  HorizontalAlignment="Stretch"
                  MouseLeftButtonDown="ImageBlock_OnMouseLeftButtonDown"
                  MouseRightButtonDown="ImageBlock_OnMouseRightButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource NotesContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy"
                                  Style="{StaticResource NotesActionMenuItemStyle}"
                                  Click="ImageCopyMenuItem_OnClick" />
                        <MenuItem Header="Cut"
                                  Style="{StaticResource NotesActionMenuItemStyle}"
                                  Click="ImageCutMenuItem_OnClick" />
                        <MenuItem Header="Delete"
                                  Style="{StaticResource NotesActionMenuItemStyle}"
                                  Click="ImageDeleteMenuItem_OnClick" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid Margin="16,5"
                      HorizontalAlignment="Center">
                <Border x:Name="ImageSelectionSurface"
                        Padding="2"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Background="Transparent">
                    <Image Source="{Binding AssetPath, Converter={StaticResource LocalImagePathConverter}}"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True">
                        <Image.Width>
                            <MultiBinding Converter="{StaticResource ResponsiveImageDimensionConverter}"
                                          ConverterParameter="Width">
                                <Binding Path="LayoutWidth" />
                                <Binding Path="ActualWidth" ElementName="NoteBlocksItemsControl" />
                                <Binding Path="AspectRatio" />
                            </MultiBinding>
                        </Image.Width>
                        <Image.Height>
                            <MultiBinding Converter="{StaticResource ResponsiveImageDimensionConverter}"
                                          ConverterParameter="Height">
                                <Binding Path="LayoutWidth" />
                                <Binding Path="ActualWidth" ElementName="NoteBlocksItemsControl" />
                                <Binding Path="AspectRatio" />
                            </MultiBinding>
                        </Image.Height>
                    </Image>
                </Border>
                <Thumb x:Name="ImageResizeThumb"
                       Style="{StaticResource NotesImageResizeThumbStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,-3,-3"
                       Visibility="Collapsed"
                       DragStarted="ImageResizeThumb_OnDragStarted"
                       DragDelta="ImageResizeThumb_OnDragDelta"
                       DragCompleted="ImageResizeThumb_OnDragCompleted" />
                </Grid>
            </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ImageSelectionSurface"
                            Property="BorderBrush"
                            Value="{DynamicResource FloatingToolsBrushSelection}" />
                    <Setter TargetName="ImageResizeThumb"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource FloatingToolsBrushSurfaceBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <sharedControls:ToolHeaderControl Grid.Row="0"
                                          Margin="6,5"
                                          Style="{StaticResource NotesToolHeaderStyle}"
                                          Title="{Binding ActiveTitle}"
                                          TitleFlowDirection="{Binding ActiveTitle, Converter={StaticResource NoteTitleDirectionConverter}}"
                                          TitleTextAlignment="{Binding ActiveTitle, Converter={StaticResource NoteTitleDirectionConverter}}"
                                          IsMenuOpen="{Binding IsMenuOpen}"
                                          ExpandedContentRoot="{Binding ElementName=NotesHeaderExpandedContent}"
                                          Command="{Binding ToggleMenuCommand}"
                                          ToolTip="Open notes" />

        <Border x:Name="NotesContentSurface"
                Grid.Row="1"
                Margin="8,0"
                Background="White"
                CornerRadius="2"
                ClipToBounds="True">
            <Grid>
            <ScrollViewer x:Name="NotePageScrollViewer"
                          Style="{StaticResource FloatingToolsSharedScrollViewerStyle}"
                          Background="White"
                          controls:SmoothWheelScrollBehavior.IsEnabled="True"
                          PreviewMouseLeftButtonDown="NotePage_OnPreviewMouseLeftButtonDown"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Stretch"
                          CanContentScroll="False">
                <Grid x:Name="NotePageContentGrid"
                      Background="White"
                      MinHeight="{Binding ViewportHeight, ElementName=NotePageScrollViewer}"
                      controls:CaretScrollMarginBehavior.IsEnabled="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="NoteBlocksItemsControl"
                                  Grid.Row="0"
                                  ItemsSource="{Binding ActiveBlocks}"
                                  Background="White"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border x:Name="TrailingInsertionZone"
                            Grid.Row="1"
                            Style="{StaticResource NotesTrailingInsertionZoneStyle}"
                            Tag="{x:Null}"
                            MouseLeftButtonDown="TrailingInsertionZone_OnMouseLeftButtonDown" />
                </Grid>
            </ScrollViewer>
            <popups:AnchoredPopupHost x:Name="NotesPopupHost"
                                      IsHitTestVisible="False"
                                      Panel.ZIndex="2" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="6,4,6,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource NotesTextActionStyle}"
                    Command="{Binding NewNoteCommand}"
                    ToolTip="New note (Ctrl+N)">
                <TextBlock Text="+" FontSize="18" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="Temporary note"
                       Margin="8,0"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsTemporary, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="2"
                    Style="{StaticResource NotesTextActionStyle}"
                    Command="{Binding KeepTemporaryNoteCommand}"
                    Content="Keep"
                    Visibility="{Binding IsTemporary, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="3"
                    Style="{StaticResource NotesTextActionStyle}"
                    Command="{Binding NewTemporaryNoteCommand}"
                    Content="Temporary"
                    ToolTip="Temporary note (Ctrl+Shift+N)" />
        </Grid>

        <Border x:Name="NotesHeaderExpandedContent"
                Grid.Row="1"
                Grid.RowSpan="2"
                Margin="0"
                Padding="0,5"
                VerticalAlignment="Top"
                MaxHeight="310"
                Background="{DynamicResource FloatingToolsBrushSurfaceHeader}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Panel.ZIndex="10"
                Visibility="{Binding IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:NoteDirectionalTextBox x:Name="NotesSearchTextBox"
                    Grid.Row="0"
                    Margin="10,2,10,7"
                    Style="{StaticResource NotesSearchTextBoxStyle}"
                    controls:TextBoxWatermark.Text="Search note titles"
                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Search note titles" />

                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource FloatingToolsSharedScrollViewerStyle}"
                              controls:SmoothWheelScrollBehavior.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NoteDocument}">
                                <Border Margin="10,1"
                                        CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceSelected}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Button Command="{Binding DataContext.SelectNoteCommand, ElementName=NotesRoot}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource NotesMenuItemStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Title}"
                                                           FlowDirection="{Binding Title, Converter={StaticResource NoteTitleDirectionConverter}}"
                                                           TextAlignment="{Binding Title, Converter={StaticResource NoteTitleDirectionConverter}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Stretch" />
                                            </Button>
                                            <controls:NoteDirectionalTextBox
                                                     Text="{Binding DataContext.RenameText, ElementName=NotesRoot, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0"
                                                     PreviewKeyDown="RenameTextBox_OnPreviewKeyDown"
                                                     LostKeyboardFocus="RenameTextBox_OnLostKeyboardFocus"
                                                     IsVisibleChanged="RenameTextBox_OnIsVisibleChanged">
                                                <controls:NoteDirectionalTextBox.Style>
                                                    <Style TargetType="{x:Type TextBox}"
                                                           BasedOn="{StaticResource NotesInputTextBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:NoteDirectionalTextBox.Style>
                                            </controls:NoteDirectionalTextBox>
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Padding="0"
                                                Content="⋯"
                                                ToolTip="Note actions"
                                                Style="{StaticResource NotesTextActionStyle}"
                                                Click="NoteActionsButton_OnClick">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource NotesContextMenuStyle}"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Rename"
                                                              Style="{StaticResource NotesActionMenuItemStyle}"
                                                              Click="RenameMenuItem_OnClick" />
                                                    <MenuItem Header="Export"
                                                              Style="{StaticResource NotesActionMenuItemStyle}"
                                                              StaysOpenOnClick="True">
                                                        <MenuItem Header="PDF"
                                                                  Style="{StaticResource NotesActionMenuItemStyle}"
                                                                  Click="ExportPdfMenuItem_OnClick" />
                                                        <MenuItem Header="Word (.docx)"
                                                                  Style="{StaticResource NotesActionMenuItemStyle}"
                                                                  Click="ExportWordMenuItem_OnClick" />
                                                    </MenuItem>
                                                    <MenuItem Header="Delete"
                                                              Style="{StaticResource NotesActionMenuItemStyle}"
                                                              Click="DeleteMenuItem_OnClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
