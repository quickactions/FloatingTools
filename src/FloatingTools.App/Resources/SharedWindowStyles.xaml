<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceSubtleHover}" />
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsScrollTrackButtonStyle"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsScrollThumbStyle"
           TargetType="{x:Type Thumb}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbSurface"
                            Width="8"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource FloatingToolsBrushScrollThumb}"
                            CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushScrollThumbPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsMinimalScrollBarStyle"
           TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="True"
                               Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource FloatingToolsScrollTrackButtonStyle}"
                                    Command="{x:Static ScrollBar.PageUpCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource FloatingToolsScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource FloatingToolsScrollTrackButtonStyle}"
                                    Command="{x:Static ScrollBar.PageDownCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsScrollViewerStyle"
           TargetType="{x:Type ScrollViewer}">
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid ClipToBounds="True">
                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="1"
                            Style="{StaticResource FloatingToolsMinimalScrollBarStyle}"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Value="{TemplateBinding VerticalOffset}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TranslationIconTemplate">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <Path Data="M3,4 L14,4 L14,13 L3,13 Z"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.7"
                      StrokeLineJoin="Round" />
                <Path Data="M10,11 L21,11 L21,20 L10,20 Z"
                      Fill="{DynamicResource FloatingToolsBrushSurfaceElevated}"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.7"
                      StrokeLineJoin="Round" />
                <Path Data="M6,7 L11,7 M6,10 L10,10 M13,14 L18,14 M13,17 L17,17"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="NotesIconTemplate">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <Path Data="M5,3 L19,3 L19,21 L5,21 Z"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.7"
                      StrokeLineJoin="Round" />
                <Path Data="M8,8 L16,8 M8,12 L16,12 M8,16 L14,16"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="QuickChatIconTemplate">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <Path Data="M3,4 L21,4 L21,17 L10,17 L5,21 L5,17 L3,17 Z"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.7"
                      StrokeLineJoin="Round" />
                <Path Data="M7,9 L17,9 M7,13 L14,13"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="CalendarIconTemplate">
        <Viewbox Width="22" Height="22">
            <Grid Width="24" Height="24">
                <Path Data="M4,5 L20,5 L20,20 L4,20 Z M4,9 L20,9"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.7"
                      StrokeLineJoin="Round" />
                <Path Data="M8,3 L8,7 M16,3 L16,7 M8,13 L9,13 M12,13 L13,13 M16,13 L17,13 M8,17 L9,17 M12,17 L13,17 M16,17 L17,17"
                      Stroke="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
