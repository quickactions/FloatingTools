    <Color x:Key="FloatingToolsColorSurfaceFocus">#FFDCDCE0</Color>
    <Color x:Key="FloatingToolsColorSurfaceInput">#FFFAFAFB</Color>
    <Color x:Key="FloatingToolsColorSurfaceHeader">#FFECECEF</Color>
    <Color x:Key="FloatingToolsColorSurfaceSelected">#FFCDCDD2</Color>
    <Color x:Key="FloatingToolsColorForegroundPrimary">#FF1C1C1E</Color>
    <Color x:Key="FloatingToolsColorForegroundSecondary">#FF48484C</Color>
    <Color x:Key="FloatingToolsColorForegroundMuted">#FF5F5F65</Color>
    <Color x:Key="FloatingToolsColorStatusError">#FFB33A3A</Color>
    <Color x:Key="FloatingToolsColorStatusSuccess">#FF2E7D44</Color>
    <Color x:Key="FloatingToolsColorBorderDefault">#FFD0D0D5</Color>
    <Color x:Key="FloatingToolsColorBorderInput">#FFC7C7CD</Color>
    <Color x:Key="FloatingToolsColorBorderDivider">#FFC9C9CE</Color>
    <Color x:Key="FloatingToolsColorSelection">#FFD7D7DC</Color>
