<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FloatingToolsSharedToolTipStyle"
           TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceSubtleHover}" />
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsStrokeThin}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingToolTip}" />
        <Setter Property="FontFamily" Value="{StaticResource FloatingToolsFontFamilyDefault}" />
        <Setter Property="FontSize" Value="{StaticResource FloatingToolsFontSizeBodySmall}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FloatingToolsRadiusInput}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
