    <SolidColorBrush x:Key="FloatingToolsBrushSurfaceMessageUser"
                     Color="{StaticResource FloatingToolsColorSurfaceMessageUser}" />
    <SolidColorBrush x:Key="FloatingToolsBrushAccentToday"
                     Color="{StaticResource FloatingToolsColorAccentToday}" />
    <SolidColorBrush x:Key="FloatingToolsBrushAccentHoliday"
                     Color="{StaticResource FloatingToolsColorAccentHoliday}" />
    <SolidColorBrush x:Key="FloatingToolsBrushAccentFavorite"
                     Color="{StaticResource FloatingToolsColorAccentFavorite}" />
    <SolidColorBrush x:Key="FloatingToolsBrushStatusWarning"
                     Color="{StaticResource FloatingToolsColorStatusWarning}" />
