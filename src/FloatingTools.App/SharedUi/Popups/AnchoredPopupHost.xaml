<UserControl x:Class="FloatingTools.App.SharedUi.Popups.AnchoredPopupHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Background="{DynamicResource FloatingToolsBrushTransparent}">
        <Popup x:Name="AnchorPopup"
               AllowsTransparency="True"
               Focusable="True"
               Placement="RelativePoint"
               PopupAnimation="None"
               StaysOpen="True"
               Closed="AnchorPopup_OnClosed">
            <Border x:Name="PopupSurface"
                    Background="{DynamicResource FloatingToolsBrushTransparent}"
                    SizeChanged="PopupSurface_OnSizeChanged">
                <ContentPresenter x:Name="PopupContent" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
