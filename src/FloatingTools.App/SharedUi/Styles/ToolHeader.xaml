<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FloatingTools.App.SharedUi.Controls">
    <Style x:Key="FloatingToolsSharedToolHeaderStyle"
           TargetType="{x:Type controls:ToolHeaderControl}"
           BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushTransparent}" />
        <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsSpacingNone}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingActionButton}" />
        <Setter Property="FontFamily" Value="{StaticResource FloatingToolsFontFamilyDefault}" />
        <Setter Property="FontSize" Value="{StaticResource FloatingToolsFontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FloatingToolsFontWeightSemibold}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="TitleHorizontalAlignment" Value="Center" />
        <Setter Property="ChevronBrush" Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
        <Setter Property="ChevronMargin" Value="8,0,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource FloatingToolsRadiusControl}" />
        <Setter Property="ChevronTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Width="12" Height="8">
                        <Path Data="M 1,1 L 6,6 L 11,1"
                              Stroke="{Binding ChevronBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:ToolHeaderControl}}}"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:ToolHeaderControl}}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M 1,6 L 6,1 L 11,6"
                              Stroke="{Binding ChevronBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:ToolHeaderControl}}}"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:ToolHeaderControl}}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToolHeaderControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Title}"
                                       Margin="{TemplateBinding TitleMargin}"
                                       FlowDirection="{TemplateBinding TitleFlowDirection}"
                                       TextAlignment="{TemplateBinding TitleTextAlignment}"
                                       HorizontalAlignment="{TemplateBinding TitleHorizontalAlignment}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="PART_SecondaryAction"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    Command="{Binding SecondaryActionCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Content="{TemplateBinding SecondaryActionContent}"
                                    ToolTip="{TemplateBinding SecondaryActionToolTip}"
                                    AutomationProperties.Name="{TemplateBinding SecondaryActionAutomationName}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSecondaryActionVisible, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding ChevronMargin}"
                                              Content="{TemplateBinding IsMenuOpen}"
                                              ContentTemplate="{TemplateBinding ChevronTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
