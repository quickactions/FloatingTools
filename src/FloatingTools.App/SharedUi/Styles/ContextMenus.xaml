<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FloatingToolsSharedContextMenuStyle"
           TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsStrokeThin}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingMenuSurface}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FloatingToolsRadiusMenu}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsSharedMenuItemStyle"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushTransparent}" />
        <Setter Property="Height" Value="{StaticResource FloatingToolsSizeMenuItemHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource FloatingToolsSizeMenuItemMinWidth}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingMenuItem}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="ItemSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FloatingToolsRadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="ItemSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfaceSubtleHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
