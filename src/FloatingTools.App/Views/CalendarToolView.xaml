<UserControl x:Class="FloatingTools.App.Views.CalendarToolView"
             x:Name="CalendarRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FloatingTools.App.Controls"
             xmlns:services="clr-namespace:FloatingTools.App.Services"
             xmlns:sharedControls="clr-namespace:FloatingTools.App.SharedUi.Controls"
             xmlns:popups="clr-namespace:FloatingTools.App.SharedUi.Popups"
             Background="{DynamicResource FloatingToolsBrushSurfaceBase}"
             FlowDirection="LeftToRight">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <services:CalendarDayPanelMinimumHeightConverter
            x:Key="CalendarDayPanelMinimumHeightConverter" />

        <Style x:Key="CalendarToolHeaderStyle"
               TargetType="{x:Type sharedControls:ToolHeaderControl}"
               BasedOn="{StaticResource FloatingToolsSharedToolHeaderStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceHeader}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
            <Setter Property="ChevronBrush" Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="CalendarMenuItemButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedActionButtonStyle}">
            <Setter Property="Height" Value="{StaticResource FloatingToolsSizeMenuItemHeight}" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CalendarCompactPopupItemButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedActionButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="CalendarNavigationButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="CalendarSingleLineInputStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource FloatingToolsSharedBorderedTextBoxStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style x:Key="FullEventsFilledFilterStyle" TargetType="ComboBox"
               BasedOn="{StaticResource SettingsComboBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushTransparent}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="30" />
        </Style>
        <!-- Template, padding, surface, border and focus now come from the
             shared input system (SharedUi/Styles/Inputs.xaml); only the filled
             search variant's own setters stay here. -->
        <Style x:Key="FullEventsFilledSearchStyle" TargetType="TextBox"
               BasedOn="{StaticResource FloatingToolsSearchTextBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushTransparent}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Alias only. CalendarSingleLineInputStyle stays as it is because the
             event editor still uses it; the menu search moves to the shared
             search family without disturbing that. -->
        <Style x:Key="CalendarMenuSearchStyle" TargetType="TextBox"
               BasedOn="{StaticResource FloatingToolsSearchTextBoxStyle}" />

        <Style x:Key="CalendarTodayButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="TodaySurface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{StaticResource FloatingToolsRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TodaySurface" Property="Background" Value="{DynamicResource FloatingToolsBrushOverlayHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TodaySurface" Property="Background" Value="{DynamicResource FloatingToolsBrushOverlayPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarMonthDayButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="DaySurface" Background="Transparent"
                                CornerRadius="{StaticResource FloatingToolsRadiusControl}">
                            <Grid>
                                <Ellipse x:Name="TodayMarker" Width="25" Height="25"
                                         Fill="{DynamicResource FloatingToolsBrushAccentToday}" Visibility="Collapsed" />
                                <TextBlock x:Name="DayNumber" Text="{Binding DayNumber}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
                                <Ellipse x:Name="EventMarker" Width="3" Height="3"
                                         Margin="0,0,0,3" HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom" Fill="{DynamicResource FloatingToolsBrushForegroundMuted}"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DaySurface" Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSurfaceSubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DaySurface" Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSurfaceFocus}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="DaySurface" Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSelection}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="TodayMarker" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource FloatingToolsBrushAccentHoliday}" />
                                <Setter TargetName="DayNumber" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                <Setter TargetName="EventMarker" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.18" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarWeekDayButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedActionButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSelection}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CalendarReadOnlyEventTextStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>

        <Style x:Key="CalendarEventActionsButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=EventRow}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CalendarViewSelectorPopupTemplate">
            <Border Width="126" Padding="{StaticResource FloatingToolsSpacingMenuSurface}"
                    Background="{DynamicResource FloatingToolsBrushSurfaceElevated}"
                    BorderBrush="{DynamicResource FloatingToolsBrushBorderDefault}"
                    BorderThickness="1" CornerRadius="{StaticResource FloatingToolsRadiusMenu}">
                <StackPanel>
                    <Button Command="{Binding ShowMonthCommand}" Click="PopupOption_OnClick"
                            AutomationProperties.Name="Month view">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CalendarMenuItemButtonStyle}">
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthView}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSelection}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding MonthLabel}" />
                    </Button>
                    <Button Command="{Binding ShowWeekCommand}" Click="PopupOption_OnClick"
                            AutomationProperties.Name="Week view">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CalendarMenuItemButtonStyle}">
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWeekView}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSelection}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding WeekLabel}" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CalendarEventActionsPopupTemplate">
            <Border x:Name="CalendarEventActionsPopupSurface" Width="100" Padding="2"
                    Background="{DynamicResource FloatingToolsBrushSurfaceElevated}"
                    BorderBrush="{DynamicResource FloatingToolsBrushBorderDefault}"
                    BorderThickness="1" CornerRadius="{StaticResource FloatingToolsRadiusMenu}">
                <StackPanel>
                    <Button Style="{StaticResource CalendarCompactPopupItemButtonStyle}"
                            Command="{Binding Owner.BeginEditEventCommand}"
                            CommandParameter="{Binding Entry}" Click="PopupOption_OnClick">
                        <TextBlock Text="{Binding Owner.EditLabel}"
                                   FlowDirection="{Binding Owner.ContentFlowDirection}"
                                   TextAlignment="{Binding Owner.ContentTextAlignment}" />
                    </Button>
                    <Button Style="{StaticResource CalendarCompactPopupItemButtonStyle}"
                            Command="{Binding Owner.CopyEventCommand}"
                            CommandParameter="{Binding Entry}" Click="PopupOption_OnClick">
                        <TextBlock Text="{Binding Owner.CopyLabel}"
                                   FlowDirection="{Binding Owner.ContentFlowDirection}"
                                   TextAlignment="{Binding Owner.ContentTextAlignment}" />
                    </Button>
                    <Button Style="{StaticResource CalendarCompactPopupItemButtonStyle}"
                            Command="{Binding Owner.DeleteEventCommand}"
                            CommandParameter="{Binding Entry}" Click="PopupOption_OnClick">
                        <TextBlock Text="{Binding Owner.DeleteLabel}"
                                   FlowDirection="{Binding Owner.ContentFlowDirection}"
                                   TextAlignment="{Binding Owner.ContentTextAlignment}" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CalendarEventsListTemplate">
            <StackPanel FlowDirection="{Binding DataContext.ContentFlowDirection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <TextBlock Margin="8,20" HorizontalAlignment="Center"
                           Text="{Binding EmptyText}"
                           Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl x:Name="ContextualEventItems"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ContextualEventRow" Margin="4,0,8,0"
                                  Background="Transparent"
                                  MouseLeftButtonDown="ContextualEventRow_OnMouseLeftButtonDown"
                                  ToolTip="{Binding DataContext.OpenToolTip, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,6,8,6" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{DynamicResource FloatingToolsBrushSurfaceElevated}"
                                        CornerRadius="{StaticResource FloatingToolsRadiusSmall}"
                                        FlowDirection="LeftToRight">
                                    <TextBlock Text="{Binding DateText}" FontSize="10"
                                               FlowDirection="LeftToRight" TextAlignment="Center"
                                               Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" />
                                </Border>
                                <Grid Grid.Column="1" Margin="0,6" VerticalAlignment="Center">
                                    <TextBlock x:Name="ContextualEventPreview"
                                               Text="{Binding Preview}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               FlowDirection="{Binding TextFlowDirection}"
                                               TextAlignment="{Binding TextAlignment}"
                                               Visibility="{Binding IsCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
                                    <TextBox x:Name="ContextualEventFullText"
                                             Style="{StaticResource CalendarReadOnlyEventTextStyle}"
                                             Text="{Binding Text, Mode=OneWay}" FlowDirection="{Binding TextFlowDirection}"
                                             TextAlignment="{Binding TextAlignment}"
                                             Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <Button x:Name="ContextualEventExpandButton" Grid.Column="2"
                                        Width="26" Height="26" VerticalAlignment="Top" Margin="0,3,0,0"
                                        Command="{Binding ToggleExpandedCommand}"
                                        Visibility="{Binding HasHiddenContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{Binding DataContext.ExpandToolTip, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
                                            <Setter Property="Content" Value="⌄" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Content" Value="⌃" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1"
                                        Background="{DynamicResource FloatingToolsBrushBorderDivider}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sharedControls:ToolHeaderControl x:Name="CalendarToolHeader" Grid.Row="0"
                                          Style="{StaticResource CalendarToolHeaderStyle}"
                                          Title="{Binding HeaderTitle}"
                                          IsMenuOpen="{Binding IsHeaderExpanded}"
                                          ExpandedContentRoot="{Binding ElementName=CalendarHeaderExpandedContent}"
                                          Command="{Binding ToggleHeaderCommand}"
                                          IsSecondaryActionVisible="{Binding IsCalendarPage}"
                                          SecondaryActionCommand="{Binding OpenContextualEventsCommand}"
                                          SecondaryActionContent="☷"
                                          SecondaryActionToolTip="{Binding EventsActionToolTip}"
                                          SecondaryActionAutomationName="{Binding EventsHeading}"
                                          ToolTip="Open Calendar menu" />

        <Grid x:Name="CalendarBody" Grid.Row="1" Margin="8,4,8,8"
              Visibility="{Binding IsCalendarPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" Panel.ZIndex="1">
                    <Button Style="{StaticResource CalendarNavigationButtonStyle}"
                            Command="{Binding NavigatePreviousCommand}" Content="‹"
                            ToolTip="Previous period" AutomationProperties.Name="Previous period" />
                    <Button Style="{StaticResource CalendarNavigationButtonStyle}"
                            Command="{Binding NavigateNextCommand}" Content="›"
                            ToolTip="Next period" AutomationProperties.Name="Next period" />
                </StackPanel>
                <TextBlock x:Name="PeriodTitleText" Grid.ColumnSpan="3" Text="{Binding PeriodTitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHebrewWeekTitle}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel x:Name="HebrewSameMonthWeekPeriodTitle" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHebrewSameMonthWeekTitle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="HebrewSameMonthWeekMonthText"
                               Text="{Binding HebrewWeekTitle.StartMonthText}"
                               FlowDirection="RightToLeft"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock Text=" " FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock x:Name="HebrewSameMonthWeekNumericText"
                               Text="{Binding HebrewWeekTitle.StartNumericText}"
                               FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                </StackPanel>
                <StackPanel x:Name="HebrewCrossMonthWeekPeriodTitle" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHebrewCrossMonthWeekTitle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="HebrewCrossMonthWeekEndMonthText"
                               Text="{Binding HebrewWeekTitle.EndMonthText}"
                               FlowDirection="RightToLeft"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock Text=" " FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock x:Name="HebrewCrossMonthWeekEndNumericText"
                               Text="{Binding HebrewWeekTitle.EndNumericText}"
                               FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock x:Name="HebrewCrossMonthWeekRangeSeparatorText"
                               Text=" – " FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock x:Name="HebrewCrossMonthWeekStartMonthText"
                               Text="{Binding HebrewWeekTitle.StartMonthText}"
                               FlowDirection="RightToLeft"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock Text=" " FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                    <TextBlock x:Name="HebrewCrossMonthWeekStartNumericText"
                               Text="{Binding HebrewWeekTitle.StartNumericText}"
                               FlowDirection="LeftToRight"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
                </StackPanel>
                <Button x:Name="ViewSelectorButton" Grid.Column="2" HorizontalAlignment="Right" Panel.ZIndex="1"
                        Style="{StaticResource FloatingToolsSharedIconButtonStyle}"
                        Click="ViewSelectorButton_OnClick" Content="⋯" FontSize="18"
                        ToolTip="Calendar view" AutomationProperties.Name="Choose calendar view" />
            </Grid>

            <Button Grid.Row="1" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="{Binding ContentHorizontalAlignment}"
                    Style="{StaticResource CalendarTodayButtonStyle}"
                    Command="{Binding GoToTodayCommand}" ToolTip="Go to today"
                    AutomationProperties.Name="Go to today">
                <TextBlock Text="{Binding TodayIndicatorText}" FontSize="11"
                           FlowDirection="{Binding ContentFlowDirection}"
                           TextAlignment="{Binding ContentTextAlignment}"
                           Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" />
            </Button>

            <Grid x:Name="CalendarPeriodRegion" Grid.Row="2"
                  SizeChanged="CalendarPeriodRegion_OnSizeChanged"
                  Background="Transparent" MouseLeftButtonDown="CalendarPeriodRegion_OnMouseLeftButtonDown">
                <ScrollViewer x:Name="MonthScrollViewer"
                              Style="{StaticResource FloatingToolsSharedScrollViewerStyle}"
                              controls:SmoothWheelScrollBehavior.IsEnabled="True"
                              Padding="{StaticResource FloatingToolsSpacingScrollContentGutter}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsMonthView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <Grid x:Name="MonthContentLayer"
                      Height="{Binding ActualHeight, ElementName=CalendarPeriodRegion}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="WeekdayHeaderItems" ItemsSource="{Binding WeekdayHeaders}"
                                  FlowDirection="{Binding ContentFlowDirection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="10"
                                           Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="MonthDayItems" Grid.Row="1" ItemsSource="{Binding MonthDays}"
                                  FlowDirection="{Binding ContentFlowDirection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding MonthWeekRowCount}" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CalendarMonthDayButtonStyle}"
                                        IsEnabled="{Binding IsSupported}"
                                        Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding Date}" AutomationProperties.Name="{Binding Date}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                    <Border x:Name="MonthOverlayInset"
                            Height="{Binding ActualHeight, ElementName=DayPanelOverlay}"
                            IsHitTestVisible="False" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="WeekScrollViewer"
                              Style="{StaticResource FloatingToolsSharedScrollViewerStyle}"
                              controls:SmoothWheelScrollBehavior.IsEnabled="True"
