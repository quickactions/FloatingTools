<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FloatingTools.App.Controls"
                    xmlns:sharedControls="clr-namespace:FloatingTools.App.SharedUi.Controls">
    <Style TargetType="{x:Type sharedControls:SettingsPageShell}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceBase}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type sharedControls:SettingsPageShell}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeaderRow"
                              Height="40"
                              Margin="8,0,10,0"
                              FlowDirection="{TemplateBinding HeaderFlowDirection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BackColumn" Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BackButton"
                                    Width="30"
                                    Height="30"
                                    Command="{TemplateBinding BackCommand}"
                                    ToolTip="{TemplateBinding BackToolTip}"
                                    AutomationProperties.Name="{TemplateBinding BackAutomationName}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
                                    </Style>
                                </Button.Style>
                                <Path Width="12"
                                      Height="12"
                                      Data="M 10,1 L 3,6 L 10,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>

                            <TextBlock x:Name="TitleText"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Title}"
                                       Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       FlowDirection="{TemplateBinding TitleFlowDirection}"
                                       TextAlignment="{TemplateBinding TitleTextAlignment}" />
                        </Grid>

                        <ScrollViewer x:Name="BodyScrollViewer"
                                      Grid.Row="1"
                                      Margin="{TemplateBinding BodyScrollMargin}"
                                      Padding="{StaticResource FloatingToolsSpacingScrollContentGutter}"
                                      Style="{StaticResource FloatingToolsSharedScrollViewerStyle}"
                                      controls:SmoothWheelScrollBehavior.IsEnabled="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      FlowDirection="LeftToRight">
                            <ContentPresenter Margin="{TemplateBinding BodyMargin}"
                                              ContentSource="Content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHeaderVisible" Value="False">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsBackVisible" Value="False">
                            <Setter TargetName="BackButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BackColumn" Property="Width" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
