<UserControl x:Class="FloatingTools.App.Views.ApplicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sharedControls="clr-namespace:FloatingTools.App.SharedUi.Controls"
             Background="{DynamicResource FloatingToolsBrushSurfaceBase}"
             IsVisibleChanged="ApplicationSettingsView_OnIsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="{x:Type ToolTip}"
               BasedOn="{StaticResource FloatingToolsSharedToolTipStyle}" />

        <Style x:Key="ApplicationSettingsActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
            <Setter Property="Height" Value="{StaticResource FloatingToolsSizeActionButtonHeight}" />
            <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingCompactActionButton}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundSecondary}" />
            <Setter Property="FontSize" Value="{StaticResource FloatingToolsFontSizeBodySmall}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ActionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource FloatingToolsRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Background"
                                        Value="{DynamicResource FloatingToolsBrushSurfaceControl}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplicationSettingsPasswordBoxStyle"
               TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <sharedControls:SettingsPageShell IsHeaderVisible="False"
                                      IsBackVisible="False"
                                      BodyMargin="18,12,2,18">
        <StackPanel>
            <TextBlock Text="Application"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="11"
                       Margin="0,4,0,7" />
            <TextBlock Text="Language"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}"
                       FontSize="13" />
            <ComboBox Margin="0,3,0,4"
                      Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding ApplicationLanguageChoices}"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedApplicationLanguage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Appearance"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}"
                       FontSize="13"
                       Margin="0,8,0,0" />
            <ComboBox Margin="0,3,0,4"
                      Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding AppearanceChoices}"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedAppearance, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Application AI"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="11"
                       Margin="0,14,0,7" />
            <TextBlock Text="Provider"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}"
                       FontSize="13" />
            <TextBlock Text="{Binding ApplicationProviderDisplayName}"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="12"
                       Margin="0,3,0,6" />
            <TextBlock Text="API Key"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}"
                       FontSize="13" />
            <TextBlock Text="{Binding ApplicationApiKeyStatus}"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="12"
                       Margin="0,3,0,4" />
            <Grid Visibility="{Binding IsApplicationApiKeyDisplayMode,
                Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStoredApplicationApiKey}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource ApplicationSettingsActionButtonStyle}"
                            Command="{Binding BeginApplicationApiKeyEditCommand}"
                            Content="Add API Key" />
                    <Button Command="{Binding TestApplicationConnectionCommand}"
                            Content="Test connection">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource ApplicationSettingsActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApplicationApiKeyConfiguration}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStoredApplicationApiKey}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource ApplicationSettingsActionButtonStyle}"
                            Command="{Binding BeginApplicationApiKeyEditCommand}"
                            Content="Replace" />
                    <Button Style="{StaticResource ApplicationSettingsActionButtonStyle}"
                            Command="{Binding RemoveApplicationApiKeyCommand}"
                            Content="Remove"
                            ToolTip="Remove the securely stored application API key" />
                    <Button Style="{StaticResource ApplicationSettingsActionButtonStyle}"
                            Command="{Binding TestApplicationConnectionCommand}"
                            Content="Test connection" />
                </StackPanel>
            </Grid>
            <StackPanel Visibility="{Binding IsApplicationApiKeyEditing,
                Converter={StaticResource BooleanToVisibilityConverter}}">
                <PasswordBox x:Name="ApplicationApiKeyPasswordBox"
                             Style="{StaticResource ApplicationSettingsPasswordBoxStyle}"
                             PasswordChar="●"
                             IsVisibleChanged="ApplicationApiKeyPasswordBox_OnIsVisibleChanged"
                             AutomationProperties.Name="New application OpenAI API key" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Style="{StaticResource ApplicationSettingsActionButtonStyle}"
                            Click="SaveApplicationApiKey_OnClick"
                            Content="Save"
                            ToolTip="Securely save the application API key" />
                    <Button Style="{StaticResource ApplicationSettingsActionButtonStyle}"
                            Click="CancelApplicationApiKey_OnClick"
                            Content="Cancel" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Default Model"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundSecondary}"
                       FontSize="13"
                       Margin="0,8,0,0" />
            <ComboBox Margin="0,3,0,4"
                      Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding ApplicationDefaultModelOptions}"
                      SelectedValuePath="Model"
                      SelectedValue="{Binding SelectedApplicationDefaultModel, Mode=TwoWay}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}"
                           BasedOn="{StaticResource SettingsComboBoxItemStyle}">
                        <Setter Property="IsEnabled"
                                Value="{Binding IsSelectable}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding ApplicationConnectionStatusMessage}"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="12"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplicationConnectionStatusMessage}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ApplicationConnectionStatusMessage}"
                                         Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Global shortcuts"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="11"
                       Margin="0,14,0,7" />
            <TextBlock Text="Show/Hide FloatingTools: Ctrl+Alt+H"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="12" />
            <TextBlock Text="Extract Text from Screen: Ctrl+Alt+T"
                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                       FontSize="12"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding GlobalShortcutsStatusMessage}"
                       Foreground="{DynamicResource FloatingToolsBrushStatusError}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GlobalShortcutsStatusMessage}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GlobalShortcutsStatusMessage}"
                                         Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </sharedControls:SettingsPageShell>
</UserControl>
