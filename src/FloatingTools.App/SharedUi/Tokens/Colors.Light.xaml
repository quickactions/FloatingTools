    <Color x:Key="FloatingToolsColorOverlayPressed">#40000000</Color>
    <Color x:Key="FloatingToolsColorScrollThumb">#FFC3C3C8</Color>
    <Color x:Key="FloatingToolsColorScrollThumbHover">#FFA8A8AE</Color>
    <Color x:Key="FloatingToolsColorScrollThumbPressed">#FF8D8D93</Color>
    <Color x:Key="FloatingToolsColorSurfaceMessageUser">#FFDCE3EE</Color>
