<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FloatingToolsSharedTextBoxStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource FloatingToolsBrushSelection}" />
        <Setter Property="SelectionOpacity" Value="{StaticResource FloatingToolsOpacitySelection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushTransparent}" />
        <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsSpacingNone}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingInput}" />
        <Setter Property="FontFamily" Value="{StaticResource FloatingToolsFontFamilyDefault}" />
        <Setter Property="FontSize" Value="{StaticResource FloatingToolsFontSizeBody}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="InputSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FloatingToolsRadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputSurface"
                                    Property="Background"
                                    Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingToolsSharedBorderedTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource FloatingToolsSharedTextBoxStyle}">
        <Setter Property="Height" Value="{StaticResource FloatingToolsSizeInputHeight}" />
        <Setter Property="Padding" Value="{StaticResource FloatingToolsSpacingBorderedInput}" />
        <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderInput}" />
        <Setter Property="BorderThickness" Value="{StaticResource FloatingToolsStrokeThin}" />
    </Style>
</ResourceDictionary>
