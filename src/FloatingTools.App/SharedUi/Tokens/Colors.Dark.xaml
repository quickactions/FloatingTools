    <system:Double x:Key="FloatingToolsOpacityDisabled">0.4</system:Double>
    <system:Double x:Key="FloatingToolsOpacitySelection">0.75</system:Double>

    <SolidColorBrush x:Key="FloatingToolsBrushTransparent"
                     Color="{StaticResource FloatingToolsColorTransparent}" />
    <SolidColorBrush x:Key="FloatingToolsBrushSurfaceBase"
                     Color="{StaticResource FloatingToolsColorSurfaceBase}" />
    <SolidColorBrush x:Key="FloatingToolsBrushSurfaceElevated"
                     Color="{StaticResource FloatingToolsColorSurfaceElevated}" />
