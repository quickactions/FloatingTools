                     Color="{StaticResource FloatingToolsColorSurfaceSubtleHover}" />
    <SolidColorBrush x:Key="FloatingToolsBrushSurfacePressed"
                     Color="{StaticResource FloatingToolsColorSurfacePressed}" />
