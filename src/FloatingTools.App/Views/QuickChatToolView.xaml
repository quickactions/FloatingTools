<UserControl x:Class="FloatingTools.App.Views.QuickChatToolView"
             x:Name="QuickChatRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FloatingTools.App.Controls"
             xmlns:converters="clr-namespace:FloatingTools.App.Converters"
             xmlns:sharedControls="clr-namespace:FloatingTools.App.SharedUi.Controls"
             Background="{DynamicResource FloatingToolsBrushSurfaceBase}"
             FlowDirection="LeftToRight">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:LocalImagePathConverter x:Key="LocalImagePathConverter" />
        <Style x:Key="QuickChatSelectableMessageTextStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="sharedControls:TripleClickSelectAllBehavior.IsEnabled" Value="True" />
        </Style>
        <Style x:Key="QuickChatActionButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedActionButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceControl}" />
        </Style>
        <Style x:Key="QuickChatMenuItemButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
            <Setter Property="Height" Value="{StaticResource FloatingToolsSizeMenuItemHeight}" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MenuRowSurface"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuRowSurface" Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuRowSurface" Property="Background" Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickChatToolHeaderStyle"
               TargetType="{x:Type sharedControls:ToolHeaderControl}"
               BasedOn="{StaticResource FloatingToolsSharedToolHeaderStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceHeader}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="ChevronBrush" Value="{DynamicResource FloatingToolsBrushForegroundMuted}" />
            <Setter Property="CornerRadius" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfacePressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickChatPendingRemoveButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FloatingToolsSharedButtonBaseStyle}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFF7F7F8" />
            <Setter Property="Foreground" Value="#FF202023" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RemoveSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveSurface" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=PendingImageHoverArea}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickChatOptionalStatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickChatComposerTextBoxStyle" TargetType="{x:Type controls:DirectionalTextBox}"
               BasedOn="{StaticResource FloatingToolsSharedTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="QuickChatSettingsTextBoxStyle" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource FloatingToolsSharedTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style x:Key="QuickChatPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource FloatingToolsBrushForegroundPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingToolsBrushBorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sharedControls:ToolHeaderControl Grid.Row="0"
                                          Style="{StaticResource QuickChatToolHeaderStyle}"
                                          Title="Quick Chat"
                                          IsMenuOpen="{Binding IsHeaderExpanded}"
                                          ExpandedContentRoot="{Binding ElementName=QuickChatHeaderExpandedContent}"
                                          Command="{Binding ToggleHeaderCommand}"
                                          IsSecondaryActionVisible="True"
                                          SecondaryActionCommand="{Binding NewChatCommand}"
                                          SecondaryActionContent="+"
                                          SecondaryActionToolTip="New Chat"
                                          SecondaryActionAutomationName="New Chat"
                                          ToolTip="Open Quick Chat menu" />

        <Grid Grid.Row="1" Visibility="{Binding IsChatPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,0,6,0">
                <ScrollViewer x:Name="ConversationScrollViewer"
                              Style="{StaticResource FloatingToolsSharedScrollViewerStyle}"
                              controls:SmoothWheelScrollBehavior.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{StaticResource FloatingToolsSpacingScrollContentGutter}"
                              ScrollChanged="ConversationScrollViewer_OnScrollChanged">
                    <ItemsControl x:Name="MessageItemsControl" ItemsSource="{Binding Messages}"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="MessageHoverArea" Margin="0,4,0,5">
                                    <Border x:Name="MessageSurface" Padding="4,5"
                                            HorizontalAlignment="Stretch" Background="Transparent" CornerRadius="8">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Attachments}"
                                                          Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,6,6" CornerRadius="5" ClipToBounds="True">
                                                            <Image Source="{Binding RuntimePath, Converter={StaticResource LocalImagePathConverter}}"
                                                                   MaxWidth="220" MaxHeight="170" Stretch="Uniform"
                                                                   Cursor="Hand"
                                                                   MouseLeftButtonDown="AttachmentImage_OnMouseLeftButtonDown" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Paragraphs}"
                                                          HorizontalContentAlignment="Stretch"
                                                          Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ContentPresenter}">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}"
                                                                 Style="{StaticResource QuickChatSelectableMessageTextStyle}"
                                                                 FlowDirection="{Binding FlowDirection}"
                                                                 TextAlignment="{Binding TextAlignment}"
                                                                 AutomationProperties.Name="Message text" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Generating…" Margin="0,5,0,0" FontSize="11"
                                                       Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}"
                                                       Visibility="{Binding IsInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="Interrupted" Margin="0,5,0,0" FontSize="11"
                                                       Foreground="{DynamicResource FloatingToolsBrushStatusWarning}"
                                                       Visibility="{Binding IsInterrupted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding ErrorMessage}" Margin="0,5,0,0" FontSize="11"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource FloatingToolsBrushStatusError}"
                                                       Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Grid x:Name="MessageActionsArea" Height="24" Margin="0,3,0,0">
                                                <Button HorizontalAlignment="Left" Width="24" Height="24" FontSize="12"
                                                        Content="⧉" ToolTip="Copy" AutomationProperties.Name="Copy"
                                                        Command="{Binding DataContext.CopyMessageCommand, ElementName=QuickChatRoot}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsAssistant}" Value="True" />
                                                                        <Condition Binding="{Binding HasText}" Value="True" />
                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=MessageHoverArea}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 To="1" Duration="0:0:0.18" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 To="0" Duration="0:0:0.30" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button HorizontalAlignment="Right" Style="{StaticResource QuickChatActionButtonStyle}"
                                                        Padding="5,2" FontSize="11" Content="Retry"
                                                        Command="{Binding DataContext.RetryCommand, ElementName=QuickChatRoot}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="MessageSurface" Property="MaxWidth" Value="320" />
                                        <Setter TargetName="MessageSurface" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageSurface" Property="Padding" Value="10,7" />
                                        <Setter TargetName="MessageSurface" Property="Background" Value="{DynamicResource FloatingToolsBrushSurfaceMessageUser}" />
                                        <Setter TargetName="MessageActionsArea" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Ask anything" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" FontSize="16" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Row="1">
            <!-- Compact composer-level error, mirroring Translation's inline
                 status. Configuration problems appear here instead of being
                 persisted as an assistant turn in the conversation. -->
            <TextBlock x:Name="ComposerErrorText"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource FloatingToolsBrushStatusError}"
                       FontSize="12"
                       Margin="8,4,6,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border x:Name="ComposerContainer"
                    Margin="8,6,6,7" Padding="7,6"
                    Background="{DynamicResource FloatingToolsBrushSurfaceInput}" BorderBrush="{DynamicResource FloatingToolsBrushBorderInput}" BorderThickness="1" CornerRadius="12"
                    AllowDrop="True"
                    PreviewDragOver="ComposerContainer_OnPreviewDragOver"
                    PreviewDrop="ComposerContainer_OnPreviewDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0" Margin="0,0,0,4" ItemsSource="{Binding PendingAttachments}"
                                  Visibility="{Binding HasPendingAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="PendingImageHoverArea" Margin="0,0,8,2" Background="Transparent">
                                    <Border Width="64" Height="50"
                                            Background="{DynamicResource FloatingToolsBrushSurfaceBase}"
                                            CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding RuntimePath, Converter={StaticResource LocalImagePathConverter}}"
                                               Width="64" Height="50" Stretch="Uniform"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="AttachmentImage_OnMouseLeftButtonDown" />
                                    </Border>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-5,-5,0" Style="{StaticResource QuickChatPendingRemoveButtonStyle}"
                                            Content="×" Command="{Binding DataContext.RemovePendingAttachmentCommand, ElementName=QuickChatRoot}"
                                            CommandParameter="{Binding}" ToolTip="Remove image"
                                            AutomationProperties.Name="Remove image" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:DirectionalTextBox x:Name="ComposerTextBox" Grid.Row="1"
                                                 MinHeight="38" MaxHeight="104" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource QuickChatComposerTextBoxStyle}"
                                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="ComposerTextBox_OnPreviewKeyDown">
                        <controls:DirectionalTextBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource FloatingToolsSharedMinimalScrollBarStyle}" />
                        </controls:DirectionalTextBox.Resources>
                    </controls:DirectionalTextBox>
                    <Grid Grid.Row="2" Margin="0,4,0,0" FlowDirection="LeftToRight">
                        <Button HorizontalAlignment="Left" Style="{StaticResource FloatingToolsSharedIconButtonStyle}"
                                Content="+" IsEnabled="{Binding CanAttachImage}" Click="AttachImageButton_OnClick"
                                ToolTip="Attach PNG or JPEG" AutomationProperties.Name="Attach image" />
                        <Button HorizontalAlignment="Right" Content="↑" ToolTip="Send"
                                AutomationProperties.Name="Send" Command="{Binding SendCommand}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button HorizontalAlignment="Right" Content="■" ToolTip="Stop"
                                AutomationProperties.Name="Stop" Command="{Binding StopCommand}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FloatingToolsSharedIconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{DynamicResource FloatingToolsBrushSurfaceBase}"
              Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <sharedControls:SettingsPageShell Title="Settings"
                                              BackCommand="{Binding BackToChatCommand}"
                                              BackToolTip="Back to chat"
                                              BackAutomationName="Back to chat">
                <StackPanel>
                    <TextBlock Text="AI" Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" FontSize="11" Margin="0,2,0,8" />
                    <CheckBox Content="Use app credentials" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                              IsChecked="{Binding Settings.UseAppCredentials, Mode=TwoWay}" />
                    <TextBlock Text="Model" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" Margin="0,10,0,3" />
                    <ComboBox Style="{StaticResource CompactFormComboBoxStyle}"
                              ItemsSource="{Binding Settings.ModelOptions}"
                              SelectedValuePath="Model"
                              SelectedValue="{Binding Settings.SelectedModel, Mode=TwoWay}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SettingsComboBoxItemStyle}">
                                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Using app credentials" Margin="0,7,0,2" Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" FontSize="12"
                               Visibility="{Binding Settings.UseAppCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Visibility="{Binding Settings.IsUsingCustomCredentials, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Provider" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding Settings.ProviderDisplayName}" Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" FontSize="12" />
                        <TextBlock Text="API Key" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding Settings.ApiKeyStatus}" Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding Settings.IsApiKeyDisplayMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Style="{StaticResource QuickChatActionButtonStyle}"
                                    Command="{Binding Settings.BeginApiKeyEditCommand}" Content="Add / Replace" />
                            <Button Style="{StaticResource QuickChatActionButtonStyle}"
                                    Command="{Binding Settings.RemoveApiKeyCommand}" Content="Remove" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Settings.IsApiKeyEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <PasswordBox x:Name="QuickChatApiKeyPasswordBox" Style="{StaticResource QuickChatPasswordBoxStyle}"
                                         PasswordChar="●" IsVisibleChanged="QuickChatApiKeyPasswordBox_OnIsVisibleChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource QuickChatActionButtonStyle}" Click="SaveApiKey_OnClick" Content="Save" />
                                <Button Style="{StaticResource QuickChatActionButtonStyle}" Click="CancelApiKey_OnClick" Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource QuickChatActionButtonStyle}" Margin="0,9,0,0"
                            HorizontalAlignment="Left" Command="{Binding Settings.TestConnectionCommand}"
                            Content="Test connection" />
                    <TextBlock Text="{Binding Settings.ConnectionStatusMessage}" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" FontSize="12"
                               Style="{StaticResource QuickChatOptionalStatusTextStyle}" />
                    <TextBlock Text="{Binding Settings.ErrorMessage}" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource FloatingToolsBrushStatusError}" FontSize="12"
                               Style="{StaticResource QuickChatOptionalStatusTextStyle}" />
                    <TextBlock Text="Additional instructions" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" Margin="0,14,0,6" />
                    <TextBox MinHeight="70" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Style="{StaticResource QuickChatSettingsTextBoxStyle}"
                             Text="{Binding AdditionalInstructions, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource QuickChatActionButtonStyle}" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Command="{Binding CommitAdditionalInstructionsCommand}"
                            Content="Save instructions" />
                </StackPanel>
            </sharedControls:SettingsPageShell>
        </Grid>

        <Border x:Name="QuickChatHeaderExpandedContent" Grid.Row="1" VerticalAlignment="Top"
                Background="{DynamicResource FloatingToolsBrushSurfaceHeader}" Panel.ZIndex="20"
                Visibility="{Binding IsHeaderExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="0,5">
                <Button Style="{StaticResource QuickChatMenuItemButtonStyle}"
                        Command="{Binding NewChatCommand}" ToolTip="Start a new chat">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="15" Margin="0,0,8,0" Text="+" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="New Chat" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickChatMenuItemButtonStyle}"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Open settings">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Margin="0,0,8,0"
                              Data="M 7.5,1.5 A 2,2 0 0 1 9.4,3 L 11.4,2.8 L 12.4,4.6 L 11.1,6.1 A 4,4 0 0 1 11.1,8.9 L 12.4,10.4 L 11.4,12.2 L 9.4,12 A 2,2 0 0 1 5.6,12 L 3.6,12.2 L 2.6,10.4 L 3.9,8.9 A 4,4 0 0 1 3.9,6.1 L 2.6,4.6 L 3.6,2.8 L 5.6,3 A 2,2 0 0 1 7.5,1.5 M 7.5,5.4 A 2.1,2.1 0 1 0 7.5,9.6 A 2.1,2.1 0 1 0 7.5,5.4"
                              Stroke="{DynamicResource FloatingToolsBrushForegroundMuted}" StrokeThickness="1" Fill="Transparent" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="2" Background="{DynamicResource FloatingToolsBrushScrim}" Panel.ZIndex="40"
              Visibility="{Binding IsNewChatConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="250" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource FloatingToolsBrushSurfaceElevated}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Start a new chat?" Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}" FontWeight="SemiBold" />
                    <TextBlock Text="The current conversation and unsent draft will be cleared."
                               Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource FloatingToolsBrushForegroundMuted}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource QuickChatActionButtonStyle}"
                                Command="{Binding CancelNewChatCommand}" Content="Cancel" />
                        <Button Style="{StaticResource QuickChatActionButtonStyle}" Margin="0"
                                Command="{Binding ConfirmNewChatCommand}" Content="New Chat" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
