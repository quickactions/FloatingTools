<Window x:Class="FloatingTools.App.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FloatingTools.App.Converters"
        Title="Image viewer"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#F21B1B1E"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseLeftButtonDown="Backdrop_OnMouseLeftButtonDown">
    <Window.Resources>
        <converters:LocalImagePathConverter x:Key="LocalImagePathConverter" />
        <Style x:Key="ViewerCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#992D2D30" />
            <Setter Property="Foreground" Value="#FFF1F1F2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#CC45454A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Image Margin="56"
               Source="{Binding ImagePath, Converter={StaticResource LocalImagePathConverter}}"
               Stretch="Uniform"
               StretchDirection="Both"
               SnapsToDevicePixels="True"
               MouseLeftButtonDown="Image_OnMouseLeftButtonDown" />
        <Button Width="38"
                Height="38"
                Margin="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="×"
                FontSize="22"
                Foreground="{DynamicResource FloatingToolsBrushForegroundPrimary}"
                Style="{StaticResource ViewerCloseButtonStyle}"
                ToolTip="Close"
                Click="CloseButton_OnClick" />
    </Grid>
</Window>
