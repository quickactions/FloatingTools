<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="FloatingToolsColorTransparent">#00FFFFFF</Color>
    <Color x:Key="FloatingToolsColorSurfaceBase">#FF252528</Color>
    <Color x:Key="FloatingToolsColorSurfaceElevated">#FF2D2D2F</Color>
    <Color x:Key="FloatingToolsColorSurfaceControl">#FF333336</Color>
    <Color x:Key="FloatingToolsColorSurfaceHover">#FF414145</Color>
    <Color x:Key="FloatingToolsColorSurfaceSubtleHover">#FF38383B</Color>
    <Color x:Key="FloatingToolsColorSurfacePressed">#FF242426</Color>
    <Color x:Key="FloatingToolsColorSurfaceFocus">#FF3D3D40</Color>
    <Color x:Key="FloatingToolsColorSurfaceInput">#FF252527</Color>
    <Color x:Key="FloatingToolsColorSurfaceHeader">#FF303033</Color>
    <Color x:Key="FloatingToolsColorSurfaceSelected">#FF424246</Color>
    <Color x:Key="FloatingToolsColorForegroundPrimary">#FFF1F1F1</Color>
    <Color x:Key="FloatingToolsColorForegroundSecondary">#FFD4D4D7</Color>
    <Color x:Key="FloatingToolsColorForegroundMuted">#FFB8B8BD</Color>
    <Color x:Key="FloatingToolsColorStatusError">#FFFFA7A7</Color>
    <Color x:Key="FloatingToolsColorBorderDefault">#FF555559</Color>
    <Color x:Key="FloatingToolsColorBorderInput">#FF55555A</Color>
